+def so10_index_from_weights(rep: str) -> Fr:
+    """Dynkin index T(R) = sum over weights of (w . e_1)^2, normalized to T(10) = 1."""
+    def raw(r: str) -> Fr:
+        return sum((w[0] ** 2 for w in so10_weights(r)), Fr(0))
+    return raw(rep) / raw("10")
+
