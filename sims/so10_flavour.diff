+            ent = {(pos[r], pos[c]): v for r, (c, v) in enumerate(zip(*m)) if r in pos and c in pos}
+            if ent:
+                mats.append(ent)
+        sym = all(e.get((j, i)) == v for e in mats for (i, j), v in e.items())
+        asym = all(e.get((j, i)) == -v for e in mats for (i, j), v in e.items())
+        vecs = []
+        for e in mats:
